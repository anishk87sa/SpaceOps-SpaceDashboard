# SpaceOps Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=your-server-jwt-fallback-secret

# Supabase Server Verification (Optional / Recommended)
# Obtain these from your Supabase Dashboard: Project Settings -> API (Publishable Key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Space Exploration External Data Feeds
LL2_API_BASE_URL=https://lldev.thespacedevs.com/2.3.0
LL2_API_KEY=
LL2_CACHE_TTL_MS=900000
